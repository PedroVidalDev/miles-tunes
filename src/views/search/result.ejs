<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/index.css">
    <link rel="stylesheet" href="/styles/search/result.css">
    <link rel="icon" type="image/png" href="/images/miles_icon.png">
    <title><%= title %></title>
</head>
<body>
    <h1>Seria esse seu video?</h1>
    <div class="video-container">
        <p> <%= data.title %> </p>
        <span> <%= data.authorName %> </span>

        <div class="image-container">

            <img id="thumb-image" src="<%= data.thumbnailUrl %>" alt="Video Thumbnail">
        
            <div class="button-container">
                <button id="download-button"> Baixar audio </button>
            </div>
        </div>
    </div>
</body>
<script src="/scripts/search/result/events.js" type="module"></script>
</html>